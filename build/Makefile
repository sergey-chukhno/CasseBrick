	$(MAKE) $(MAKESILENT) -f CMakeFiles\CyberpunkCannonShooter.dir\build.make CMakeFiles/CyberpunkCannonShooter.dir/src/ui/Starfield.cpp.i
.PHONY : src/ui/Starfield.cpp.i

src/ui/Starfield.s: src/ui/Starfield.cpp.s
.PHONY : src/ui/Starfield.s

# target to generate assembly for a file
src/ui/Starfield.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\CyberpunkCannonShooter.dir\build.make CMakeFiles/CyberpunkCannonShooter.dir/src/ui/Starfield.cpp.s
.PHONY : src/ui/Starfield.cpp.s

